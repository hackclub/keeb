---
import Button from './Button.astro';
import KeyboardVisual from './KeyboardVisual.astro';
---

<section class="hero bg-grid">

  <div class="hero__photos hero__photos--left" aria-hidden="true">
    <img class="photo" src="/Photos/KB1.png" alt="" style="--r: -6deg; --y: 2%" />
    <img class="photo" src="/Photos/KB3.png" alt="" style="--r: 4deg;  --y: 26%" />
    <img class="photo" src="/Photos/KB5.png" alt="" style="--r: -8deg; --y: 50%" />
    <img class="photo" src="/Photos/KB7.png" alt="" style="--r: 5deg;  --y: 74%" />
  </div>

  <div class="hero__photos hero__photos--right" aria-hidden="true">
    <img class="photo" src="/Photos/KB2.png" alt="" style="--r: 7deg;  --y: 2%" />
    <img class="photo" src="/Photos/KB4.png" alt="" style="--r: -5deg; --y: 26%" />
    <img class="photo" src="/Photos/KB6.png" alt="" style="--r: 6deg;  --y: 50%" />
    <img class="photo" src="/Photos/KB8.png" alt="" style="--r: -4deg; --y: 74%" />
  </div>

  <div class="hero__content">
    <h1 class="hero__title" id="hero-title">
      BUILD YOUR<br />OWN <span class="hero__accent">KEYBOARD</span>
    </h1>
    <p class="hero__sub">
      A Hack Club you-ship-we-ship project.<br />
      Follow the guide. We ship the parts. You build it.
    </p>
    <div class="hero__cta">
      <Button href="/docs" variant="primary">START BUILDING</Button>
    </div>
  </div>
  <div class="hero__keyboard">
    <KeyboardVisual />
  </div>

  <div class="hero__strip">
    <img src="/Photos/Group 1.png" alt="Keyboard builds" />
  </div>
</section>

<script>
  // Typed-in + glitch effect on the hero heading — mirrors the KEEB SHOP title.
  // The real text lives in the markup as a fallback (no-JS / SEO); we clear and retype it here.
  const titleEl = document.getElementById('hero-title');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (titleEl && !reduce) {
    // "OWN " is followed by the accented "KEYBOARD", and there's a line break after "BUILD YOUR".
    const SEGMENTS = [
      { text: 'BUILD YOUR' },
      { br: true },
      { text: 'OWN ' },
      { text: 'KEYBOARD', accent: true },
    ];

    const steps: { ch?: string; accent?: boolean; br?: boolean }[] = [];
    for (const seg of SEGMENTS) {
      if (seg.br) { steps.push({ br: true }); continue; }
      for (const ch of seg.text!) steps.push({ ch, accent: seg.accent });
    }

    titleEl.textContent = '';

    // Astro scopes component styles with a data-astro-cid-* attribute. Elements we
    // build in JS don't inherit it, so the scoped .hero__accent / .type-cursor rules
    // (red colour, underline, blink) won't apply unless we copy the attribute over.
    const scopeAttr = titleEl.getAttributeNames().find((n) => n.startsWith('data-astro-cid-'));
    const scope = <T extends HTMLElement>(el: T): T => {
      if (scopeAttr) el.setAttribute(scopeAttr, '');
      return el;
    };

    const typed = scope(document.createElement('span'));
    const cursor = scope(document.createElement('span'));
    cursor.className = 'type-cursor';
    cursor.textContent = '|';
    titleEl.append(typed, cursor);

    let accentSpan: HTMLSpanElement | null = null;
    let i = 0;

    function typeNext() {
      if (i >= steps.length) {
        // done typing — keep the caret (blinks when idle), start occasional glitch bursts
        setTimeout(() => {
          startIdleCaret();
          scheduleGlitch();
        }, 900);
        return;
      }
      const step = steps[i++];
      if (step.br) {
        typed.appendChild(document.createElement('br'));
        accentSpan = null;
        setTimeout(typeNext, 90);
        return;
      }
      if (step.accent) {
        if (!accentSpan) {
          accentSpan = scope(document.createElement('span'));
          accentSpan.className = 'hero__accent';
          typed.appendChild(accentSpan);
        }
        accentSpan.textContent += step.ch;
      } else {
        typed.appendChild(document.createTextNode(step.ch!));
      }
      setTimeout(typeNext, i === 1 ? 350 : 80 + Math.random() * 60);
    }

    // ── occasional, randomized glitch burst (at least 10s apart) ──
    function scheduleGlitch() {
      const delay = 10000 + Math.random() * 15000; // 10s–25s
      setTimeout(() => {
        titleEl!.classList.add('glitch-burst');
        setTimeout(() => titleEl!.classList.remove('glitch-burst'), 400);
        scheduleGlitch();
      }, delay);
    }

    // ── caret blinks when idle, holds steady while the user types ──
    function startIdleCaret() {
      let idleTimer: number | undefined;
      document.addEventListener('keydown', () => {
        cursor.classList.add('solid');
        clearTimeout(idleTimer);
        idleTimer = window.setTimeout(() => cursor.classList.remove('solid'), 1000);
      });
    }

    setTimeout(typeNext, 600);
  }
</script>

<style>
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero {
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(5rem, 12vh, 10rem) 1.5rem 0;
    position: relative;
    overflow: hidden;
  }

  .hero__content {
    text-align: center;
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .hero__title {
    font-size: clamp(2.5rem, 8vw, 6rem);
    line-height: 0.95;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
    animation: enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    /* reserve two lines so the typing animation doesn't push the page down */
    min-height: 1.9em;
    /* gentle persistent chromatic depth ("3D") — visible but not overpowering */
    text-shadow: 1.5px 0 #e11d48, -1.5px 0 #06b6d4;
  }

  /* ── TYPED-IN CURSOR (matches the shop) ──────────────── */
  .type-cursor {
    display: inline-block;
    color: #e11d48;
    font-weight: 300;
    animation: blink 0.75s step-end infinite;
  }

  .type-cursor.hidden {
    display: none;
  }

  /* caret holds steady while the user is actively typing, blinks when idle */
  .type-cursor.solid {
    animation: none;
    opacity: 1;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── GLITCH BURST — fired occasionally from JS (random, >=20s apart) ─ */
  .hero__title.glitch-burst {
    animation: glitch-burst 0.4s steps(2, end);
  }

  /* subtle one-shot: clean before/after, only a faint chromatic offset mid-burst */
  @keyframes glitch-burst {
    0%, 100% { text-shadow: 1.5px 0 #e11d48, -1.5px 0 #06b6d4; clip-path: none; transform: translate(0); }
    25% { text-shadow: 3px 0 #e11d48, -3px 0 #06b6d4; clip-path: inset(15% 0 55% 0); transform: translate(-1px, 0); }
    50% { text-shadow: -3px 0 #06b6d4, 3px 0 #e11d48; clip-path: inset(55% 0 15% 0); transform: translate(1px, 0); }
    75% { text-shadow: 3px 0 #e11d48, 0 0 transparent; clip-path: inset(35% 0 35% 0); transform: translate(-1px, 0); }
  }

  .hero__accent {
    color: #e11d48;
    position: relative;
  }

  .hero__accent::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.05em;
    width: 100%;
    height: 4px;
    background: #9f1239;
  }

  .hero__sub {
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.8;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    animation: enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .hero__cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    animation: enter 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .hero__keyboard {
    margin-top: clamp(1.5rem, 4vh, 3rem);
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 750px;
    flex-shrink: 0;
    animation: enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }

  .hero__photos {
    position: absolute;
    top: 5rem;
    bottom: 0;
    width: 220px;
    pointer-events: none;
    z-index: 0;
  }

  .hero__photos--left { left: 0; }
  .hero__photos--right { right: 0; }

  .photo {
    position: absolute;
    width: 180px;
    aspect-ratio: 4/3;
    object-fit: cover;
    top: var(--y);
    rotate: var(--r);
    border: 6px solid var(--white);
    box-shadow: 4px 4px 0 var(--purple-deep);
    display: block;
  }

  .hero__photos--left .photo { right: 0.5rem; }
  .hero__photos--right .photo { left: 0.5rem; }

  .hero__strip {
    position: absolute;
    bottom: 1in;
    left: 220px;
    right: 220px;
    line-height: 0;
    z-index: 0;
  }

  .hero__strip img {
    width: 85%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 1100px) {
    .hero__photos { display: none; }
    .hero__strip { display: none; }
  }

  @media (max-width: 768px) {
    .hero {
      padding: clamp(3rem, 8vh, 5rem) 1rem 0;
    }

    .hero__sub {
      font-size: 0.85rem;
    }

    .hero__keyboard {
      margin-top: 1rem;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .hero__cta {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
