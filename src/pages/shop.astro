            <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <div>
          <div class="profile-name">Hacker</div>
          <div class="profile-rank">Switch Wizard</div>
        </div>
      </div>
      <div class="stats-row">
        <div class="stat">
          <div class="stat-val red" id="coin-count">0</div>
          <div class="stat-lbl">COINS</div>
        </div>
        <div class="stat">
          <div class="stat-val">42h</div>
          <div class="stat-lbl">HOURS</div>
        </div>
        <div class="stat">
          <div class="stat-val">3</div>
          <div class="stat-lbl">CLAIMED</div>
        </div>
