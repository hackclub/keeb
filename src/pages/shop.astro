    <div class="modal-actions">
      <button class="btn btn-outline" id="modal-cancel">Cancel</button>
      <button class="btn btn-primary" disabled style="opacity:0.5;cursor:not-allowed">Request Redemption</button>
    </div>
  </div>
</div>

</body>
</html>

