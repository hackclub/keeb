      <!-- switch housing -->
      <rect x="25" y="10" width="40" height="60" rx="4" stroke="white" stroke-width="2" fill="none" opacity="0.18" stroke-dasharray="5 2"/>
      <!-- stem -->
      <rect x="35" y="5" width="20" height="25" rx="2" stroke="white" stroke-width="1.8" fill="none" opacity="0.18"/>
      <!-- spring -->
      <path d="M38 50 Q45 56 52 50 Q45 44 38 50" stroke="white" stroke-width="1.5" fill="none" opacity="0.2"/>
      <text x="10" y="86" fill="white" font-size="7.5" opacity="0.22" font-family="monospace">clicky internals</text>
