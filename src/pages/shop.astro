      <button class="btn btn-disabled" disabled>Connect Hack Club Account<span class="soon-badge">Coming Soon</span></button>
    </div>
  </div>
</section>

<!-- ═══════════════ MID DIVIDER ═══════════════════════════════ -->
<div class="mid-divider">
  <!-- sketchy circuit lines -->
  <div class="sketch sketch-circuit" aria-hidden="true">
    <svg width="300" height="40" viewBox="0 0 300 40" fill="none">
      <polyline points="0,20 40,20 50,8 80,8 90,20 150,20 160,32 190,32 200,20 260,20 270,8 300,8"
                stroke="white" stroke-width="1.8" fill="none" opacity="0.12" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="90" cy="20" r="3" stroke="white" stroke-width="1.5" fill="none" opacity="0.15"/>
