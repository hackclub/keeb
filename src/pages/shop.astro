  :root {
    --red:       #e11d48;
    --bg:        #050505;
    --card-bg:   #0d0d0d;
    --border:    #1f1f1f;
    --text:      #f2f2f2;
    --muted:     #737373;
    --common:    #a3a3a3;
    --rare:      #3b82f6;
