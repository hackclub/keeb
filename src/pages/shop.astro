    <rect x="36" y="30" width="18" height="15" rx="3" stroke="white" stroke-width="2" fill="none" opacity="0.22"/>
    <rect x="58" y="30" width="18" height="15" rx="3" stroke="white" stroke-width="2" fill="none" opacity="0.22"/>
    <rect x="80" y="30" width="18" height="15" rx="3" stroke="white" stroke-width="2" fill="none" opacity="0.22"/>
    <rect x="102" y="30" width="18" height="15" rx="3" stroke="white" stroke-width="2" fill="none" opacity="0.22"/>
    <rect x="124" y="30" width="18" height="15" rx="3" stroke="white" stroke-width="2" fill="none" opacity="0.22"/>
    <rect x="146" y="30" width="18" height="15" rx="3" stroke="white" stroke-width="2" fill="none" opacity="0.22"/>
    <rect x="168" y="30" width="18" height="15" rx="3" stroke="white" stroke-width="2" fill="none" opacity="0.22"/>
