          class="rarity-badge sticker sticker-xs"
          style={`color:${RARITY_COLOR[r.rarity] ?? "#a3a3a3"};border-color:${RARITY_COLOR[r.rarity] ?? "#a3a3a3"};box-shadow:2px 2px 0 ${RARITY_COLOR[r.rarity] ?? "#a3a3a3"}`}
