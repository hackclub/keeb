    id: "lubing-kit",
    title: "Complete Lubing Kit",
    description: "Includes Krytox 205g0, a premium brush, stem picker, and a secure metal switch opener.",
    cost: 450, rarity: "EPIC", category: "TOOLS",
    image: "https://cdn.hackclub.com/019ed250-7146-725f-bfc4-fc5a5da63451/untitled_design.svg"
  },
  {
    id: "mystery-box",
    title: "Cyberpunk Mystery Box",
    description: "A legendary drop containing a completely randomized premium keyboard accessory drop.",
    cost: 1200, rarity: "LEGENDARY", category: "EXCLUSIVE",
    image: "https://images.unsplash.com/photo-1579546929518-9e396f3cc809?auto=format&fit=crop&w=600&q=80"
  }
];

let rewards: Reward[] = FALLBACK;

if (AIRTABLE_API_KEY && AIRTABLE_BASE_ID) {
  try {
    const res = await fetch(
      `https://api.airtable.com/v0/${AIRTABLE_BASE_ID}/${encodeURIComponent(AIRTABLE_TABLE)}`,
      { headers: { Authorization: `Bearer ${AIRTABLE_API_KEY}` } }
    );
    if (res.ok) {
      const data: any = await res.json();
      const mapped: Reward[] = (data.records ?? []).map((r: any) => ({
        id: r.id,
        title: r.fields?.Name ?? "",
        description: r.fields?.Description ?? "",
        cost: Number(r.fields?.Cost ?? 0),
        rarity: (r.fields?.Rarity ?? "COMMON").toUpperCase(),
        category: (r.fields?.Category ?? "TOOLS").toUpperCase(),
        image: r.fields?.Image?.[0]?.url ?? r.fields?.ImageURL ?? "",
        meta: r.fields?.Meta ?? undefined,
      })).filter((r: Reward) => r.title);
      if (mapped.length > 0) rewards = mapped;
    }
  } catch (_) {
    /* silently fall back to hardcoded data */
  }
}

const RARITY_COLOR: Record<string, string> = {
  COMMON: "#a3a3a3",
  RARE: "#3b82f6",
  EPIC: "#f43f5e",
  LEGENDARY: "#fbbf24",
  EXCLUSIVE: "#a855f7"
};

const categories = ["ALL", "KEYCAPS", "SWITCHES", "TOOLS", "ACCESSORIES", "EXCLUSIVE"];

const rewardsJson = JSON.stringify(rewards);
const rarityColorJson = JSON.stringify(RARITY_COLOR);
