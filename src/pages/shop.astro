    </div>
    <div class="progress-bar-bg">
      <div class="progress-bar-fill" id="prog-bar" style="width:0%"></div>
    </div>
    <div class="progress-meta">
      <span class="prog-coins"><span id="prog-count">0</span> / 1500 COINS</span>
      <span class="prog-hint">250 Coins Until Artisan Crafter</span>
    </div>
  </div>
</section>

<!-- ═══════════════ REWARDS GRID ════════════════════════════ -->
<section id="rewards" class="rewards-section">
  <!-- sketchy switch cross-section decoration -->
  <div class="sketch sketch-switch" aria-hidden="true">
