      ))}
    </div>
  </div>

  <div class="rewards-grid" id="rewards-grid">
    {rewards.map((r) => (
      <div
        class="reward-card"
        data-cat={r.category}
        data-rarity={r.rarity}
        data-id={r.id}
        data-title={r.title}
        data-cost={r.cost}
        data-desc={r.description}
        style={`--rarity-color:${RARITY_COLOR[r.rarity] ?? "#a3a3a3"}`}
