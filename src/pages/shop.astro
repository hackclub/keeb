</footer>

<!-- ═══════════════ REDEMPTION MODAL ════════════════════════ -->
<div class="modal-overlay" id="modal" aria-hidden="true">
  <div class="modal-box" role="dialog" aria-modal="true">
    <button class="modal-close" id="modal-close" aria-label="Close">x</button>
    <span class="sticker sticker-sm rotate-neg color-red abs-sticker" style="top:-1rem;left:1rem">SYSTEM MESSAGE</span>
